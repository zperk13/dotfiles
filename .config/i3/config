bindsym $mod+d exec rofi -show drun -theme gruvbox-dark -font "JetBrainsMonoNF 13" -show-icons
bindsym $mod+Tab exec rofi -show window -theme gruvbox-dark -font "JetBrainsMonoNF 13" -show-icons
