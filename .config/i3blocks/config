# Base16 Gruvbox dark, medium
# Scheme Author: Dawid Kurek (hello@dawikur.dev), morhetz (https://github.com/morhetz/gruvbox)

separator=true
separator_block_width=15

[stats]
color=#d5c4a1
interval=persist
command=scripts/stats

[bandwidth]
color=#d5c4a1
command=scripts/bandwidth
interval=5
#INTERFACE=eth0
#INLABEL=IN 
#OUTLABEL=OUT 
#TREAT_UNKNOWN_AS_UP=0

[time]
color=#d5c4a1
command=date '+%a %b %d %H:%M:%S '
interval=1
